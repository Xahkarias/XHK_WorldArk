spriteTypes = {
    # origin image
    spriteType = {
        name = "GFX_origin_xhk_worldark"
        texturefile = "gfx/event_pictures/origins/origin_xhk_worldark.dds"
        alwaystransparent = yes
    }


    ####################################################################################################################
    # overlay
    spriteType = {
        name = GFX_xhk_district_resources_sprite_sheet
        textureFile = gfx/interface/icons/resources/xhk_worldark_district_resources.dds
        noOfFrames = 5
    }
    spriteType = { # not used, we use the gigas one
        name = GFX_xhk_worldark_dark_matter_spec
        sprite_sheet_sprite_type = GFX_xhk_district_resources_sprite_sheet
        default_frame = 1
    }
    spriteType = {
        name = GFX_xhk_worldark_storage_spec
        sprite_sheet_sprite_type = GFX_xhk_district_resources_sprite_sheet
        default_frame = 2
    }
    spriteType = {
        name = GFX_xhk_worldark_mbrain_spec
        sprite_sheet_sprite_type = GFX_xhk_district_resources_sprite_sheet
        default_frame = 3
    }
    # hello sparble
    spriteType = {
        name = GFX_xhk_worldark_cultobrium_spec
        sprite_sheet_sprite_type = GFX_xhk_district_resources_sprite_sheet
        default_frame = 4
    }
    spriteType = {
        name = GFX_xhk_worldark_necrophage_spec
        sprite_sheet_sprite_type = GFX_xhk_district_resources_sprite_sheet
        default_frame = 5
    }

    ####################################################################################################################
    # background
    corneredTileSpriteType = {
        name = "GFX_district_xhk_worldark_storage_bg"
        texturefile = "gfx/interface/planetview/district_backgrounds/district_xhk_worldark_storage_bg.dds"
    }
    corneredTileSpriteType = {
        name = "GFX_district_xhk_worldark_refinery_bg"
        texturefile = "gfx/interface/planetview/district_backgrounds/district_xhk_worldark_refinery_bg.dds"
    }
	corneredTileSpriteType = {
		name = "GFX_district_xhk_worldark_darkmatter_bg"
		texturefile = "gfx/interface/planetview/district_backgrounds/district_xhk_worldark_darkmatter_bg.dds"
	}
	corneredTileSpriteType = {
		name = "GFX_district_xhk_worldark_negativemass_bg"
